# ==========================================
# Databases & Caching
# ==========================================
MONGODB_URI=
REDIS_URL=

# ==========================================
# Application Configuration
# ==========================================
PORT=
LOG_LEVEL=
NODE_ENV=
ALLOWED_ORIGINS=

# ==========================================
# Security & Encryption
# ==========================================
JWT_SECRET_KEY= 
MEDICAL_DATA_KEY=

# ==========================================
# File Storage (Vercel Blob — create a Blob store in the Vercel dashboard, token is added automatically)
# ==========================================
BLOB_READ_WRITE_TOKEN=
# Health Vault PDFs use a separate PRIVATE Blob store (token of that store)
PRIVATE_BLOB_READ_WRITE_TOKEN=

# ==========================================
# Local development only. Uncomment if "querySrv ECONNREFUSED" stops you from reaching MongoDB Atlas.
# Never set this on the server (Vercel): production uses the platform's own DNS.
# ==========================================
# DNS_SERVERS=8.8.8.8,8.8.4.4

# ==========================================
# Email (verification + password reset). Any SMTP provider works.
# Leave SMTP_HOST empty on your own computer: emails are then printed in the terminal instead of sent.
# ==========================================
FRONTEND_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ==========================================
# Third-Party Integrations (OAuth)
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==========================================
# Initial Doctor Accounts
# ==========================================
DOCTOR_1_NAME=
DOCTOR_1_EMAIL=
DOCTOR_1_PASSWORD=

DOCTOR_2_NAME=
DOCTOR_2_EMAIL=
DOCTOR_2_PASSWORD=

DOCTOR_3_NAME=
DOCTOR_3_EMAIL=
DOCTOR_3_PASSWORD=

